<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main LinearLayout for content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@android:color/white">

        <!-- Horizontal LinearLayout for TextView and ImageButton -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="15dp"
            android:gravity="center_vertical">

            <!-- TextView for "Your Categories" -->
            <TextView
                android:id="@+id/textViewCategories"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/your_categories"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_weight="1" />  <!-- This makes the TextView take up available space -->

            <!-- ImageButton -->
            <ImageButton
                android:id="@+id/btnAddCategory"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_plus_icon"
                android:background="@drawable/button_safe"
                android:layout_marginStart="8dp" />  <!-- Optional: Adds space between the text and the button -->
        </LinearLayout>

        <!-- RecyclerView for displaying categories -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

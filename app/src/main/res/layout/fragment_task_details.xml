<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Task Title -->
        <TextView
            android:id="@+id/task_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[insert_task_title]"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="5dp"
            android:layout_marginLeft="18dp" />

        <!-- Task Creation Date -->
        <TextView
            android:id="@+id/task_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Created on [month]_[date],_[year]"
            android:textSize="14sp"
            android:layout_marginBottom="30dp"
            android:layout_marginLeft="18dp" />

        <!-- Task Name Section -->
        <TextView
            android:id="@+id/tv_task_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/study_task_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/et_task_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_task_name"
            android:background="@android:drawable/edit_text"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <!-- Objective Section -->
        <TextView
            android:id="@+id/tv_objective"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/objective"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/et_objective"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_objective"
            android:background="@android:drawable/edit_text"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <!-- Materials Section -->
        <TextView
            android:id="@+id/tv_materials_needed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/materials_needed"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/et_materials_needed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_materials_needed"
            android:background="@android:drawable/edit_text"
            android:inputType="text"
            android:layout_marginBottom="10dp" />

        <!-- Category Section -->
        <TextView
            android:id="@+id/tv_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/category"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <!-- Status Section -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <RadioGroup
            android:id="@+id/radioGroup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp">
            <RadioButton
                android:id="@+id/rb_not_started"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/not_started" />
            <RadioButton
                android:id="@+id/rb_in_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/in_progress" />
            <RadioButton
                android:id="@+id/rb_finished"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/finished" />
        </RadioGroup>

        <!-- Date Section -->
        <TextView
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/date"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/et_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_date_yyyy_mm_dd"
            android:background="@android:drawable/edit_text"
            android:gravity="center_vertical"
            android:inputType="date"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="10dp" />

        <!-- Time Range Section -->
        <TextView
            android:id="@+id/tv_time_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/time_range"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/et_time_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hh_mm"
            android:background="@android:drawable/edit_text"
            android:inputType="time"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="10dp" />

        <!-- Until Section -->
        <TextView
            android:id="@+id/tv_until"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/until"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/et_until"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hh_mm"
            android:background="@android:drawable/edit_text"
            android:inputType="time"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="10dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/updatetask_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_bg"
                android:text="@string/update"
                android:textColor="@color/white"
                android:layout_marginRight="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/deletetask_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_danger"
                android:text="@string/delete"
                android:textColor="@color/white"
                android:layout_marginLeft="10dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
